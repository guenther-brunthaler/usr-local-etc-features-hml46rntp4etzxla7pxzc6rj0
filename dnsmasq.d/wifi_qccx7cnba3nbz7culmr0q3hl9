# v2026.244

# basic:
bogus-priv
dhcp-authoritative
domain-needed
localise-queries
no-poll
# fixed_assignments:
dhcp-hostsfile=/etc/dnsmasq.overrides
# interfaces:
bind-dynamic
#listen-address=10.48.888.999
listen-address=10.222.888.999
listen-address=10.41.888.999
#interface=ethernet
interface=wifi
interface=bluetooth

dhcp-leasefile=/var/run/dnsmasq/leases

# Nameservers
no-resolv
server=1.1.1.1
server=9.9.9.9

# logging:
#log-dhcp
#log-facility=/tmp/dnsmasq.log
#log-queries
log-facility=/dev/null

# networks:
# This snippet is grouped into blocks. The order between the blocks should not
# be changed. The lines within each block is sorted lexicographically, except
# for commments which always come first.

# Associate networks with domain names.
#domain=eth.emgenxx69lwyn5ctlr4nl64ul.local,10.48.0.0/16,local
domain=wifi.emgenxx69lwyn5ctlr4nl64ul.local,10.222.0.0/16,local
domain=bt.emgenxx69lwyn5ctlr4nl64ul.local,10.41.0.0/16,local

# Define DHCP ranges within networks and assign range aliases.
#dhcp-range=set:ethernet,10.48.223.250,10.48.255.254,infinite
dhcp-range=set:wifi,10.222.223.250,10.222.255.254,infinite
dhcp-range=set:bluetooth,10.41.223.250,10.41.255.254,infinite

# Associate range aliases with domain names.
#dhcp-option=tag:ethernet,option:domain-name,eth.emgenxx69lwyn5ctlr4nl64ul.local
dhcp-option=tag:wifi,option:domain-name,wifi.emgenxx69lwyn5ctlr4nl64ul.local
dhcp-option=tag:bluetooth,option:domain-name,bt.emgenxx69lwyn5ctlr4nl64ul.local

# other_options:
dhcp-option=option:ntp-server,0.0.0.0 # IP address only
dhcp-option=option:time-offset,3600 # TZ offset from UTC in seconds, east >= 0
dhcp-option=4,0.0.0.0 # time server (RFC 868, port 37, 32 bit UTC since epoch)
dhcp-option=option:posix-timezone,CET-1CEST-2,M3.5.0,M10.5.0/3 # POSIX $TZ
dhcp-option=option:tzdb-timezone,Europe/Vienna # Linux $TZ
# Catch/disable semi-dangerous Web Proxy Autodiscovery Protocol.
dhcp-option=252,"\n" # wpad
dhcp-option=option:nis-domain,emgenxx69lwyn5ctlr4nl64ul.local

